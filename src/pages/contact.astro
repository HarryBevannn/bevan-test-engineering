---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE } from '../consts';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const inputClass =
  'mt-2 block w-full rounded-lg border border-ink-200 px-4 py-3 text-ink-900 focus:border-accent-600 focus:ring-2 focus:ring-accent-100 focus:outline-none';
---

<Layout title="Contact" description="Get in touch with Bevan Test Engineering to discuss your software testing needs.">
  <section class="container-page pt-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight text-ink-900">Get in touch</h1>
        <p class="mt-4 max-w-xl text-lg text-ink-500">
          Tell me a little about your project and I'll reply within one working day to arrange a free,
          no-obligation call.
        </p>

        <!--
          Handled by Netlify Forms: submissions appear in the Netlify dashboard and can be emailed to you.
          The hidden "bot-field" is a honeypot to catch spam bots.
        -->
        <form
          name="contact"
          method="POST"
          action="/thanks/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-10 max-w-xl space-y-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="name" class="font-medium text-ink-900">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="email" class="font-medium text-ink-900">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="company" class="font-medium text-ink-900">Company <span class="font-normal text-ink-500">(optional)</span></label>
            <input id="company" name="company" type="text" autocomplete="organization" class={inputClass} />
          </div>
          <div>
            <label for="service" class="font-medium text-ink-900">What can I help with?</label>
            <select id="service" name="service" class={inputClass}>
              {services.map((s) => <option>{s.data.title}</option>)}
              <option>Something else / not sure yet</option>
            </select>
          </div>
          <div>
            <label for="message" class="font-medium text-ink-900">Message</label>
            <textarea id="message" name="message" rows="6" required class={inputClass}></textarea>
          </div>
          <button type="submit" class="btn-primary">Send message</button>
        </form>
      </div>

      <aside class="h-fit rounded-xl bg-ink-50 p-6">
        <h2 class="font-semibold text-ink-900">Prefer email?</h2>
        <p class="mt-2">
          <a href={`mailto:${SITE.email}`} class="font-medium text-accent-700 underline underline-offset-2">{SITE.email}</a>
        </p>
        <h2 class="mt-6 font-semibold text-ink-900">Connect</h2>
        <p class="mt-2">
          <a href={SITE.linkedin} rel="noopener" class="font-medium text-accent-700 underline underline-offset-2">LinkedIn</a>
        </p>
        <h2 class="mt-6 font-semibold text-ink-900">Based in</h2>
        <p class="mt-2 text-ink-700">{SITE.location}, working remotely with clients anywhere</p>
      </aside>
    </div>
  </section>
</Layout>
