---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import LibraryRings from '../../components/birmingham/LibraryRings.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services" description="Software testing services: test strategy, QA consultancy, and Playwright and API test automation.">
  <PageHeader
    title="Services"
    intro="Whether you need a full test strategy or a hand with one specific problem, here's how I can help."
    caption="Inspired by the interlocking rings of the Library of Birmingham."
  >
    <LibraryRings slot="motif" />
  </PageHeader>

  <section class="container-page mt-16">
    <div class="grid gap-6 sm:grid-cols-2">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>
  <CallToAction />
</Layout>
