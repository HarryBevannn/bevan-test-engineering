---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CallToAction from '../../components/CallToAction.astro';
import PageHeader from '../../components/PageHeader.astro';
import LibraryRings from '../../components/birmingham/LibraryRings.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<Layout title={service.data.title} description={service.data.summary}>
  <PageHeader title={service.data.title} intro={service.data.summary}>
    <a slot="before" href="/services/" class="mb-4 inline-block text-sm font-medium text-accent-500 hover:underline">
      ← All services
    </a>
    <LibraryRings slot="motif" />
  </PageHeader>

  <div class="container-page mt-12 grid gap-12 lg:grid-cols-[1fr_18rem]">
    <div class="prose-content">
      <Content />
    </div>
    {
      service.data.highlights.length > 0 && (
        <aside class="h-fit rounded-xl border border-ink-100 p-6">
          <h2 class="font-semibold text-ink-900">Includes</h2>
          <ul class="mt-4 space-y-3 text-ink-700">
            {service.data.highlights.map((item) => (
              <li class="flex gap-2">
                <span class="text-accent-600" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <CallToAction heading={`Interested in ${service.data.title.toLowerCase()}?`} />
</Layout>
