---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="container-page pt-24 text-center">
    <p class="font-mono text-sm font-semibold text-accent-700">404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-900">This page failed its test</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-500">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-10">Back to home</a>
  </section>
</Layout>
