---
import Layout from '../layouts/Layout.astro';
import SpaghettiJunction from '../components/birmingham/SpaghettiJunction.astro';
import { TEST_IDS } from '../test-ids';
---

<Layout title="Page not found">
  <section class="container-page pt-20 text-center">
    <div class="mx-auto h-40 max-w-xs">
      <SpaghettiJunction />
    </div>
    <p class="mt-8 font-mono text-sm font-semibold text-accent-700">404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-900">Took a wrong turn at Spaghetti Junction?</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-500">
      This page doesn't exist or has moved. Let's get you back on the right road.
    </p>
    <a href="/" class="btn-primary mt-10" data-testid={TEST_IDS.notFound.homeButton}>Back to home</a>
  </section>
</Layout>
