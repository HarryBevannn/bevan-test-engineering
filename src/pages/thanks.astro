---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thanks">
  <section class="container-page pt-24 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-ink-900">Thanks for getting in touch</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-500">
      Your message has been sent. I'll get back to you within one working day.
    </p>
    <a href="/" class="btn-secondary mt-10">Back to home</a>
  </section>
</Layout>
