---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CallToAction from '../components/CallToAction.astro';
import Skyline from '../components/Skyline.astro';
import { TEST_IDS } from '../test-ids';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// PLACEHOLDER: edit these to reflect how you work
const approach = [
  {
    title: 'Understand',
    text: 'I get to know your product, team and delivery process, and find where the real quality risks are.',
  },
  {
    title: 'Plan',
    text: 'We agree a focused, risk-based plan with clear outcomes, not a pile of documents.',
  },
  {
    title: 'Deliver',
    text: 'I work hands-on alongside your team to build tests, tooling and practices that last.',
  },
  {
    title: 'Hand over',
    text: 'Your team is left owning it, with documentation and coaching so nothing depends on me.',
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-900">
    <div class="container-page pt-20 pb-8 sm:pt-28">
      <div class="hero-fade">
      <p class="text-sm font-semibold tracking-widest text-accent-500 uppercase">
        Software testing consultancy · Birmingham
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
        Ship with confidence. Find the bugs <span class="text-accent-500">before your customers do.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">
        Bevan Test Engineering helps software teams build quality in, with reliable Playwright test
        automation, testing built into your CI/CD pipeline, and custom tools that make QA more efficient.
      </p>
      </div>
      <div class="hero-fade-delay mt-10 flex flex-wrap gap-4">
        <a href="/contact/" class="btn-primary" data-testid={TEST_IDS.home.consultationButton}>Book a free consultation</a>
        <a
          href="/services/"
          data-testid={TEST_IDS.home.servicesButton}
          class="inline-flex items-center justify-center rounded-lg border border-ink-500 px-5 py-3 font-semibold text-white transition hover:border-ink-200"
        >
          View services
        </a>
      </div>
    </div>
    <Skyline />
  </section>

  <!-- Credibility strip -->
  <section class="border-b border-ink-100 bg-ink-50">
    <ul class="container-page grid gap-4 py-6 text-center text-sm font-medium text-ink-700 sm:grid-cols-3">
      <li><span class="font-bold text-ink-900">8+ years</span> in test engineering</li>
      <li><span class="font-bold text-ink-900">Playwright</span> end-to-end automation</li>
      <li><span class="font-bold text-ink-900">API testing</span> with Postman &amp; REST Assured</li>
    </ul>
  </section>

  <!-- Services -->
  <section class="container-page mt-20" aria-labelledby="services-heading">
    <h2 id="services-heading" class="text-3xl font-bold text-ink-900">Services</h2>
    <p class="mt-3 max-w-2xl text-ink-500">Engagements tailored to where your team needs the most help.</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <!-- Proof: this site tests itself -->
  <section class="container-page mt-20" aria-labelledby="proof-heading">
    <div class="flex flex-col gap-6 rounded-2xl border border-accent-100 bg-accent-50 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <div>
        <p class="text-sm font-semibold tracking-widest text-accent-700 uppercase">Practising what I preach</p>
        <h2 id="proof-heading" class="mt-2 text-2xl font-bold text-ink-900 sm:text-3xl">Websites that test themselves</h2>
        <p class="mt-3 max-w-xl text-ink-700">
          Every change to this site runs through an automated Playwright pipeline before it goes live, and nothing is
          published unless every test passes. Don't believe me?
        </p>
      </div>
      <a href="/quality/" class="btn-primary shrink-0" data-testid={TEST_IDS.home.qualityButton}>See it in action →</a>
    </div>
  </section>

  <!-- Approach -->
  <section class="container-page mt-24" aria-labelledby="approach-heading">
    <h2 id="approach-heading" class="text-3xl font-bold text-ink-900">How I work</h2>
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        approach.map((step, i) => (
          <li>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-100 font-bold text-accent-700">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink-900">{step.title}</h3>
            <p class="mt-2 text-ink-500">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CallToAction />
</Layout>
