---
// Dark page banner used on inner pages. Pass a Birmingham motif in the "motif" slot
// and an optional caption explaining the landmark.
interface Props {
  title: string;
  intro?: string;
  caption?: string;
}

const { title, intro, caption } = Astro.props;
const hasMotif = Astro.slots.has('motif');
---

<section class="overflow-hidden bg-ink-900">
  <div class="container-page grid items-center gap-8 py-14 sm:py-16 md:grid-cols-[1fr_16rem]">
    <div>
      <slot name="before" />
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">{title}</h1>
      {intro && <p class="mt-4 max-w-2xl text-lg text-ink-200">{intro}</p>}
    </div>
    {
      hasMotif && (
        <figure class="hidden md:block">
          <div class="h-40">
            <slot name="motif" />
          </div>
          {caption && <figcaption class="mt-3 text-xs text-ink-200">{caption}</figcaption>}
        </figure>
      )
    }
  </div>
</section>
