---
import { TEST_IDS } from '../test-ids';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Want to talk about your testing?',
  text = 'Tell me about your product and where quality is hurting. I’ll come back within one working day.',
} = Astro.props;
---

<section class="container-page mt-24">
  <div class="rounded-2xl bg-ink-900 px-6 py-12 text-center sm:px-12">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{heading}</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-200">{text}</p>
    <a href="/contact/" class="btn-primary mt-8" data-testid={TEST_IDS.callToAction.contactButton}>Get in touch</a>
  </div>
</section>
