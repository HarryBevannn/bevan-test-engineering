---
// Stylised Birmingham skyline silhouette, left to right:
// Library of Birmingham, the Rotunda, BT Tower, 103 Colmore Row, Selfridges (Bullring), the Cube.
// Colours come from the theme tokens, so it follows whichever palette is active.
import Bull from './birmingham/Bull.astro';
---

<svg
  viewBox="0 0 1440 240"
  preserveAspectRatio="xMidYMax slice"
  class="block h-40 w-full sm:h-56"
  aria-hidden="true"
  focusable="false"
>
  <!-- Back layer: generic city blocks -->
  <g class="fill-ink-800">
    <rect x="0" y="170" width="70" height="70" />
    <rect x="60" y="140" width="50" height="100" />
    <rect x="290" y="150" width="60" height="90" />
    <rect x="440" y="120" width="70" height="120" />
    <rect x="500" y="160" width="50" height="80" />
    <rect x="620" y="100" width="60" height="140" />
    <rect x="760" y="130" width="70" height="110" />
    <rect x="1070" y="140" width="70" height="100" />
    <rect x="1270" y="120" width="60" height="120" />
    <rect x="1320" y="160" width="120" height="80" />
  </g>

  <g class="fill-ink-700">
    <!-- Library of Birmingham: stacked tiers with the gold rotunda on top -->
    <rect x="120" y="150" width="160" height="90" />
    <rect x="132" y="108" width="136" height="42" />
    <rect x="144" y="72" width="112" height="36" />
    <rect x="178" y="54" width="44" height="18" />
    <path d="M178 54 Q200 38 222 54 Z" />

    <!-- The Rotunda -->
    <rect x="365" y="62" width="70" height="178" />
    <rect x="359" y="54" width="82" height="10" />

    <!-- BT Tower -->
    <rect x="572" y="44" width="16" height="196" />
    <rect x="563" y="62" width="34" height="9" />
    <rect x="563" y="78" width="34" height="9" />
    <rect x="565" y="94" width="30" height="7" />
    <rect x="579" y="12" width="2" height="32" />

    <!-- 103 Colmore Row -->
    <rect x="700" y="22" width="46" height="218" />
    <rect x="705" y="14" width="36" height="8" />

    <!-- Selfridges -->
    <path d="M840 240 C838 172 872 128 932 128 C990 128 1006 166 1036 172 C1062 177 1062 212 1060 240 Z" />

    <!-- The Cube -->
    <rect x="1150" y="108" width="112" height="132" />
    <rect x="1172" y="92" width="68" height="16" />
  </g>

  <!-- Accent details: library rings, lit windows, Selfridges discs -->
  <g class="fill-none stroke-accent-500" stroke-width="2" opacity="0.6">
    <circle cx="170" cy="128" r="10" />
    <circle cx="200" cy="128" r="10" />
    <circle cx="230" cy="128" r="10" />
    <circle cx="160" cy="90" r="9" />
    <circle cx="188" cy="90" r="9" />
    <circle cx="216" cy="90" r="9" />
    <circle cx="244" cy="90" r="9" />
  </g>
  <g class="fill-accent-500" opacity="0.7">
    <rect x="375" y="80" width="50" height="3" />
    <rect x="375" y="100" width="50" height="3" />
    <rect x="375" y="120" width="50" height="3" />
    <rect x="375" y="140" width="50" height="3" />
    <rect x="375" y="160" width="50" height="3" />
    <rect x="375" y="180" width="50" height="3" />
    <rect x="712" y="40" width="4" height="190" />
    <rect x="730" y="40" width="4" height="190" />
    <rect x="1165" y="125" width="10" height="10" />
    <rect x="1205" y="155" width="10" height="10" />
    <rect x="1235" y="130" width="10" height="10" />
    <rect x="1185" y="195" width="10" height="10" />
  </g>
  <g class="fill-accent-500" opacity="0.35">
    {
      Array.from({ length: 8 }, (_, row) =>
        Array.from({ length: 14 }, (_, col) => {
          const cx = 862 + col * 14 + (row % 2) * 7;
          const cy = 150 + row * 12;
          // keep discs inside the Selfridges outline (roughly)
          const inside = cy > 140 + Math.abs(cx - 940) * 0.35 || (cx > 990 && cy > 182);
          return inside && cx < 1052 ? <circle cx={cx} cy={cy} r="4" /> : null;
        })
      )
    }
  </g>

  <!-- The Bullring Bull, charging out in front of Selfridges -->
  <Bull transform="translate(1036 162) scale(1.18)" />
</svg>
