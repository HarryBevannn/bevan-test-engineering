---
import { NAV, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink-900 text-ink-200">
  <div class="container-page grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <p class="font-bold text-white">{SITE.name}</p>
      <p class="mt-2 text-sm">{SITE.tagline} · {SITE.location}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="space-y-2 text-sm">
        {NAV.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>
    <ul class="space-y-2 text-sm">
      <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>
      <li><a href={SITE.linkedin} class="hover:text-white" rel="noopener">LinkedIn</a></li>
    </ul>
  </div>
  <div class="border-t border-ink-700">
    <p class="container-page py-4 text-xs text-ink-200">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>
