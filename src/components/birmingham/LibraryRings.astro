---
// The interlocking rings of the Library of Birmingham's facade.
const rows = 5;
const cols = 8;
---

<svg viewBox="0 0 260 170" class="h-full w-full" aria-hidden="true" focusable="false">
  <g class="fill-none stroke-accent-500" stroke-width="2.5">
    {
      Array.from({ length: rows }, (_, r) =>
        Array.from({ length: cols }, (_, c) => (
          <circle
            cx={22 + c * 31 + (r % 2) * 15}
            cy={22 + r * 31}
            r="20"
            opacity={(0.15 + ((c + r) % 4) * 0.2).toFixed(2)}
          />
        ))
      )
    }
  </g>
</svg>
