---
// Brand logo: a teal tile holding a tick whose long stroke sweeps up like a bull's horn
// (quality assurance + the Bullring Bull), followed by the wordmark.
// `tone` sets the wordmark colours for light or dark backgrounds.
interface Props {
  tone?: 'light-bg' | 'dark-bg';
  class?: string;
}

const { tone = 'light-bg', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" class="fill-accent-600" />
    <path
      d="M8.5 16.5 L13.5 21.5 C15.5 15.5 19 10.5 25 8"
      fill="none"
      stroke="#fff"
      stroke-width="3.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="leading-none">
    <span class:list={['block text-lg font-extrabold tracking-tight', tone === 'light-bg' ? 'text-ink-900' : 'text-white']}>
      Bevan
    </span>
    <span
      class:list={[
        'mt-0.5 block text-[0.68rem] font-semibold tracking-[0.18em] uppercase',
        tone === 'light-bg' ? 'text-ink-500' : 'text-ink-200',
      ]}
    >
      Test Engineering
    </span>
  </span>
</span>
