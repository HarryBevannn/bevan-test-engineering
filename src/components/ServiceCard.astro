---
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
---

<article class="group relative flex flex-col rounded-xl border border-ink-100 bg-white p-6 transition hover:border-accent-500 hover:shadow-md">
  <h3 class="text-lg font-semibold text-ink-900">
    <a href={`/services/${service.id}/`} class="after:absolute after:inset-0">
      {service.data.title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-ink-500">{service.data.summary}</p>
  <span class="mt-4 text-sm font-semibold text-accent-700 group-hover:underline" aria-hidden="true">
    Learn more →
  </span>
</article>
